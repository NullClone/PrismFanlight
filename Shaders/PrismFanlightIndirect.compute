#pragma kernel ClearIndirectArgs
#pragma kernel CullBlocks
#pragma kernel BuildVisibleInstances
#pragma kernel GenerateVisibleAnimation
#pragma kernel GenerateAllAnimation
#pragma kernel GenerateVisibleFrameData
#pragma kernel GenerateAllFrameData

#include "PrismFanlightComputeContext.hlsl"
#include "PrismFanlightCulling.hlsl"
#include "PrismFanlightMotion.hlsl"
#include "PrismFanlightAudience.hlsl"

[numthreads(4, 1, 1)]
void ClearIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x < (uint)_PenlightVariantCount)
        _PenlightArgs[id.x].instanceCount = 0;
    if (id.x == 0u)
        _AudienceArgs[0].instanceCount = 0;
}

[numthreads(64, 1, 1)]
void CullBlocks(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_BlockCountValue) return;

    FanlightBlockData block = _Blocks[id];
    float4 worldCenter = mul(_LocalToWorld, float4(block.localCenterRadius.xyz, 1.0));
    _BlockVisibility[id] = (_EnableCulling == 0 || PrismSphereInFrustum(worldCenter.xyz,
                                                                        block.localCenterRadius.w * _CullingScale))
                               ? 1
                               : 0;
}

groupshared uint _GroupVariantVisibleCount[4];
groupshared uint _GroupVariantBaseOffset[4];
groupshared uint _GroupAudienceVisibleCount;
groupshared uint _GroupAudienceBaseOffset;

[numthreads(128, 1, 1)]
void BuildVisibleInstances(uint3 dispatchId : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex < 4u)
    {
        _GroupVariantVisibleCount[groupIndex] = 0;
        _GroupVariantBaseOffset[groupIndex] = 0;
    }
    if (groupIndex == 0)
    {
        _GroupAudienceVisibleCount = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    uint id = dispatchId.x;
    bool visible = false;
    bool audienceVisible = false;
    uint variantIndex = 0u;

    if (id < (uint)_InstanceCount)
    {
        FanlightSeatData seat = _Seats[id];
        uint blockIndex = (uint)(seat.planePositionBlock.z + seat.planePositionBlock.w * _BlockCount.x);
        visible = _BlockVisibility[blockIndex] != 0;
        variantIndex = min(_PenlightVariantAssignments[id], (uint)max(0, _PenlightVariantCount - 1));

        if (visible)
        {
            float3 seatWorldPos = mul(_LocalToWorld, float4(seat.localPositionSeed.xyz, 1.0)).xyz;
            float visibleDistance = max(0.0, _AudienceLod.x);
            float3 toCamera = seatWorldPos - _LodCameraPos.xyz;
            audienceVisible = _EnableAudienceLod == 0 || dot(toCamera, toCamera) <= visibleDistance * visibleDistance;
        }
    }

    uint localSlot = 0;
    if (visible)
        InterlockedAdd(_GroupVariantVisibleCount[variantIndex], 1, localSlot);

    uint localAudienceSlot = 0;
    if (audienceVisible)
        InterlockedAdd(_GroupAudienceVisibleCount, 1, localAudienceSlot);

    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < (uint)_PenlightVariantCount)
    {
        InterlockedAdd(
            _PenlightArgs[groupIndex].instanceCount,
            _GroupVariantVisibleCount[groupIndex],
            _GroupVariantBaseOffset[groupIndex]);
    }
    if (groupIndex == 0)
    {
        InterlockedAdd(_AudienceArgs[0].instanceCount, _GroupAudienceVisibleCount * 3u, _GroupAudienceBaseOffset);
        _GroupAudienceBaseOffset /= 3u;
    }
    GroupMemoryBarrierWithGroupSync();

    if (visible)
        _PenlightVisibleIndices[_PenlightVariantOffsets[variantIndex] + _GroupVariantBaseOffset[variantIndex] + localSlot] = id;

    if (audienceVisible)
    {
        uint audienceSlot = _GroupAudienceBaseOffset + localAudienceSlot;
        _AudienceSlots[id] = audienceSlot;
        _AudienceVisibleIndices[audienceSlot] = id;
    }
    else if (id < (uint)_InstanceCount)
    {
        _AudienceSlots[id] = 0xFFFFFFFFu;
    }
}

bool PrismTryGetVariantVisibleSeat(uint capacitySlot, out uint seatIndex)
{
    seatIndex = 0u;
    for (uint variantIndex = 0u; variantIndex < (uint)_PenlightVariantCount; variantIndex++)
    {
        uint start = _PenlightVariantOffsets[variantIndex];
        uint end = variantIndex + 1u < (uint)_PenlightVariantCount
            ? _PenlightVariantOffsets[variantIndex + 1u]
            : (uint)_InstanceCount;
        if (capacitySlot < start || capacitySlot >= end) continue;

        uint visibleCount = _PenlightArgs[variantIndex].instanceCount;
        uint relativeSlot = capacitySlot - start;
        if (relativeSlot >= visibleCount) return false;
        seatIndex = _PenlightVisibleIndices[capacitySlot];
        return true;
    }

    return false;
}

[numthreads(128, 1, 1)]
void GenerateVisibleAnimation(uint3 dispatchId : SV_DispatchThreadID)
{
    uint visibleSlot = dispatchId.x;
    uint id;
    if (!PrismTryGetVariantVisibleSeat(visibleSlot, id)) return;
    FanlightSeatData seat = _Seats[id];
    _FanlightMatrices[id] = PrismComputeMatrix(seat, PrismPenlightGripPivotY(id));
}

[numthreads(128, 1, 1)]
void GenerateAllAnimation(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_InstanceCount) return;

    FanlightSeatData seat = _Seats[id];
    _FanlightMatrices[id] = PrismComputeMatrix(seat, PrismPenlightGripPivotY(id));
}

[numthreads(128, 1, 1)]
void GenerateVisibleFrameData(uint3 dispatchId : SV_DispatchThreadID)
{
    uint visibleSlot = dispatchId.x;

    uint id;
    if (PrismTryGetVariantVisibleSeat(visibleSlot, id))
    {
        FanlightSeatData seat = _Seats[id];
        PrismHumanPose pose;
        PrismArm arm;
        PrismComputeFrameData(seat, PrismPenlightGripPivotY(id), pose, arm);
        _FanlightMatrices[id] = arm.worldMatrix;

        if (_AudienceSlots[id] != 0xFFFFFFFFu)
        {
            PrismBuildAudienceParts(id, pose, arm);
        }
    }
}

[numthreads(128, 1, 1)]
void GenerateAllFrameData(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id < (uint)_InstanceCount)
    {
        FanlightSeatData seat = _Seats[id];
        PrismHumanPose pose;
        PrismArm arm;
        PrismComputeFrameData(seat, PrismPenlightGripPivotY(id), pose, arm);
        _FanlightMatrices[id] = arm.worldMatrix;

        PrismBuildAudienceParts(id, pose, arm);
    }
}

