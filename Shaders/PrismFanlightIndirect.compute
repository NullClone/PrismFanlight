#pragma kernel ClearIndirectArgs
#pragma kernel CullBlocks
#pragma kernel BuildVisibleInstances
#pragma kernel GenerateVisibleAnimation
#pragma kernel GenerateAllAnimation
#pragma kernel GenerateAllColors
#pragma kernel GenerateVisibleAudience
#pragma kernel GenerateAllAudience
#pragma kernel ScaleAudienceArgs

#include "PrismFanlightTypes.hlsl"

StructuredBuffer<FanlightSeatData> _Seats;
StructuredBuffer<FanlightBlockData> _Blocks;
RWStructuredBuffer<uint> _BlockVisibility;
RWStructuredBuffer<uint> _VisibleIndices;
RWStructuredBuffer<uint> _DrawArgs;
RWStructuredBuffer<float4x4> _FanlightMatrices;
RWStructuredBuffer<float4> _FanlightColors;
RWStructuredBuffer<FanlightAudiencePart> _AudienceParts;
RWStructuredBuffer<uint> _AudienceArgs;

int _InstanceCount;
int _BlockCountValue;
float4x4 _LocalToWorld;
float _FanlightTime;
float4 _FanlightBeat;
float4 _FanlightTempo;
float4 _FrustumPlanes[6];
float _CullingScale;
int _EnableCulling;

float4 _SeatPitch;
float4 _BlockCount;
float4 _MotionTiming;
float4 _MotionSwing;
float4 _MotionShape;
int _SwingMode;
float4 _SwingWrist;
float4 _SwingAxis;
float4 _SwingTargetPos;
float4x4 _WorldToLocal;
float4 _MotionVariation;
float4 _MotionNoise;
float4 _MotionHuman;
float4 _MotionRest;
float4 _MotionRestTiming;
float4 _MotionBeat;
float4 _MotionBeatSpread;
float _GripPivotY;
int _ColorMode;
float4 _PrimaryColor;
float4 _SecondaryColor;
float4 _Brightness;
int _PaletteColorCount;
float4 _PaletteColors[16];
float4 _AudienceShape;
float4 _AudienceArm;
float4 _AudienceReach;
float4 _AudienceMotionBody;
float4 _AudienceMotionHead;
float4 _AudienceShoulder;
float4 _AudienceVariation;
float4 _AudienceCrowd;
float _HandBaseHeight;

#include "PrismFanlightMath.hlsl"
#include "PrismFanlightCulling.hlsl"
#include "PrismFanlightAnimation.hlsl"
#include "PrismFanlightAudience.hlsl"

[numthreads(1, 1, 1)]
void ClearIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    _DrawArgs[1] = 0;
}

[numthreads(64, 1, 1)]
void CullBlocks(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_BlockCountValue) return;

    FanlightBlockData block = _Blocks[id];
    float4 worldCenter = mul(_LocalToWorld, float4(block.localCenterRadius.xyz, 1.0));
    _BlockVisibility[id] = (_EnableCulling == 0 || PrismSphereInFrustum(worldCenter.xyz,
                                                                        block.localCenterRadius.w * _CullingScale))
                               ? 1
                               : 0;
}

groupshared uint _GroupVisibleCount;
groupshared uint _GroupBaseOffset;

[numthreads(128, 1, 1)]
void BuildVisibleInstances(uint3 dispatchId : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0)
        _GroupVisibleCount = 0;
    GroupMemoryBarrierWithGroupSync();

    uint id = dispatchId.x;
    bool visible = false;

    if (id < (uint)_InstanceCount)
    {
        FanlightSeatData seat = _Seats[id];
        uint blockIndex = (uint)(seat.planePositionBlock.z + seat.planePositionBlock.w * _BlockCount.x);
        visible = _BlockVisibility[blockIndex] != 0;
    }

    uint localSlot = 0;
    if (visible)
        InterlockedAdd(_GroupVisibleCount, 1, localSlot);
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0)
        InterlockedAdd(_DrawArgs[1], _GroupVisibleCount, _GroupBaseOffset);
    GroupMemoryBarrierWithGroupSync();

    if (visible)
        _VisibleIndices[_GroupBaseOffset + localSlot] = id;
}

[numthreads(128, 1, 1)]
void GenerateVisibleAnimation(uint3 dispatchId : SV_DispatchThreadID)
{
    uint visibleSlot = dispatchId.x;
    if (visibleSlot >= _DrawArgs[1]) return;

    uint id = _VisibleIndices[visibleSlot];
    FanlightSeatData seat = _Seats[id];
    _FanlightMatrices[id] = PrismComputeMatrix(seat);
}

[numthreads(128, 1, 1)]
void GenerateAllAnimation(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_InstanceCount) return;

    FanlightSeatData seat = _Seats[id];
    _FanlightMatrices[id] = PrismComputeMatrix(seat);
}

[numthreads(128, 1, 1)]
void GenerateAllColors(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_InstanceCount) return;

    FanlightSeatData seat = _Seats[id];
    _FanlightColors[id] = PrismComputeColor(seat);
}

[numthreads(128, 1, 1)]
void GenerateVisibleAudience(uint3 dispatchId : SV_DispatchThreadID)
{
    uint visibleSlot = dispatchId.x;
    if (visibleSlot >= _DrawArgs[1]) return;

    PrismBuildAudienceParts(_VisibleIndices[visibleSlot]);
}

[numthreads(128, 1, 1)]
void GenerateAllAudience(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= (uint)_InstanceCount) return;

    PrismBuildAudienceParts(id);
}

[numthreads(1, 1, 1)]
void ScaleAudienceArgs(uint3 id : SV_DispatchThreadID)
{
    // 席ごとに 3 パーツ（体・腕・頭）を描く。
    _AudienceArgs[1] = _DrawArgs[1] * 3u;
}
